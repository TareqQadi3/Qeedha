# قيّدها Backend Environment Variables
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/qeedha?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_SECRET=change-me-min-32-characters-secret
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Encryption (AES-256-GCM)
ENCRYPTION_KEY=change-me-32-bytes-encryption-key

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN_SECONDS=120
OTP_MAX_ATTEMPTS=3
OTP_RATE_LIMIT_PER_MINUTE=3

# QR
QR_TOTP_SECRET=change-me-qr-totp-secret
QR_EXPIRES_IN_SECONDS=60

# Financing Gateway
MANUAL_ADAPTER_ENABLED=true

# Notifications
UNIFONIC_API_URL=https://api.unifonic.com
UNIFONIC_API_KEY=
UNIFONIC_SENDER_ID=
UNIFONIC_EMAIL_FROM=
UNIFONIC_WHATSAPP_TEMPLATE=
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Auth OTP delivery channel (EMAIL now; SMS/WHATSAPP once subscribed; independent of Nafath)
AUTH_OTP_CHANNEL=EMAIL

# Nafath (disabled until government approval + real credentials — see NAFATH_ENABLED)
NAFATH_ENABLED=false
NAFATH_API_URL=
NAFATH_API_KEY=
NAFATH_APP_ID=
