{
  "name": "qeedha",
  "version": "0.1.0",
  "private": true,
  "description": "قيّدها (Qeedha) — منصة رصيد البقالة الممول بالتقسيط",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "db:generate": "pnpm --filter api db:generate",
    "db:validate": "pnpm --filter api db:validate",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:deploy": "pnpm --filter api db:deploy",
    "db:studio": "pnpm --filter api db:studio",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.3.4",
    "typescript": "^5.7.3",
    "prettier": "^3.4.2",
    "eslint": "^8.57.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.11.0"
}
